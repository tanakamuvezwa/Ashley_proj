# Server port (default: 5000)
PORT=5000

# JWT secret for auth tokens
JWT_SECRET=apexlend-sadc-jwt-secret-2026

# MongoDB connection (optional — falls back to local JSON if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/apexlend

# Google Gemini API key (optional — free at https://aistudio.google.com/apikey)
# Without this key, the chatbot uses a smart local AI with live platform data.
GEMINI_API_KEY=
